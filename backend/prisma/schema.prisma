generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MEMBER
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum PaymentProvider {
  PAYSTACK
}

enum SaleStatus {
  PAID
  PENDING
  OVERDUE
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  users         User[]
  customers     Customer[]
  products      Product[]
  sales         Sale[]
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  passwordHash   String
  role           Role     @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdSales   Sale[]   @relation("SaleCreatedBy")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  price         Float // NGN per billing period
  currency      String         @default("NGN")
  billingPeriod String         @default("monthly")
  features      Json // e.g. { "teamMembers": 3, "reports": true }
  limits        Json // e.g. { "customers": 200, "products": 100, "monthlySales": 500 } (null = unlimited)
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  invoices           Invoice[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
}

model Invoice {
  id                String          @id @default(cuid())
  invoiceNumber     String          @unique
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId    String
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id])
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id])
  amount            Float
  currency          String          @default("NGN")
  status            InvoiceStatus   @default(PENDING)
  provider          PaymentProvider
  providerReference String?         @unique
  receiptUrl        String?
  periodStart       DateTime
  periodEnd         DateTime
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId])
}

model Customer {
  id         String   @id @default(cuid())
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  sales      Sale[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
}

model Product {
  id         String     @id @default(cuid())
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  price      Float
  saleItems  SaleItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([orgId])
}

model Sale {
  id            String     @id @default(cuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceNumber String
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal      Float
  discount      Float      @default(0)
  tax           Float      @default(0)
  total         Float
  status        SaleStatus @default(PAID)
  paidAt        DateTime?
  notes         String?
  createdById   String
  createdBy     User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items         SaleItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String // snapshot of the product name at sale time
  unitPrice   Float
  quantity    Int
  total       Float
}
