# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://salesbook:salesbook@localhost:5432/salesbook

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
# Where Paystack redirects the user after payment (frontend billing page)
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing
